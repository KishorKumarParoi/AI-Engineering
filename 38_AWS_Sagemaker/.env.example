# AWS Credentials & Region
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# SageMaker Execution Role ARN (Required for running on AWS)
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/service-role/AmazonSageMaker-ExecutionRole

# S3 Artifacts Bucket (Optional, defaults to sagemaker-default bucket if omitted)
S3_BUCKET_NAME=sagemaker-mobile-price-classification-mlops

# Local API Configuration
API_HOST=0.0.0.0
API_PORT=8000
