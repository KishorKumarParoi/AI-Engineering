# ============================================================
# NEXUS-AI: Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ---- Mode Configuration ----
NEXUS_MODE=local                    # local | cloud
CLOUD_PROVIDER=gcp                  # gcp | aws | azure
CLOUD_REGION=us-central1

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# GOOGLE_API_KEY=your-gemini-key
# ANTHROPIC_API_KEY=your-claude-key

# ---- GCP Configuration ----
GCP_PROJECT_ID=your-gcp-project
GCP_BUCKET_NAME=nexus-ai-lakehouse
GCP_BIGQUERY_DATASET=nexus_ai
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- AWS Configuration ----
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexus-ai-lakehouse

# ---- Azure Configuration ----
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER=nexus-ai-lakehouse

# ---- MLflow Configuration ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nexus-ai-delivery-eta

# ---- Prometheus / Grafana ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=nexus-admin

# ---- Database (Local Demo) ----
DUCKDB_PATH=./data/nexus_ai.duckdb

# ---- Notification Services ----
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SENDGRID_API_KEY=your-sendgrid-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nexus-ai

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ---- Security ----
JWT_SECRET=your-jwt-secret-change-in-production
API_RATE_LIMIT=100                  # requests per minute
