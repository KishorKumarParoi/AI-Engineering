# ==============================================================================
# Sample Terraform Configuration Variables: Production Multi-Cloud Topology
# Rename to terraform.tfvars and fill with actual credentials/values
# ==============================================================================

project_name = "zomato-ai"
environment  = "production"

# --- AWS Configuration ---
aws_region              = "us-east-1"
aws_vpc_cidr            = "10.0.0.0/16"
eks_cluster_version     = "1.30"
eks_node_instance_types = ["t3.xlarge", "m5.xlarge"]
eks_min_nodes           = 2
eks_max_nodes           = 6

# --- GCP Configuration ---
gcp_project_id   = "zomato-ai-platform-prod"
gcp_region       = "us-central1"
gcp_subnet_cidr  = "10.10.0.0/20"
gke_machine_type = "e2-standard-4"
gke_min_nodes    = 1
gke_max_nodes    = 5

# --- Global Routing ---
domain_name = "zomato-ai.production.internal"
